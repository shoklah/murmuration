{
  "manifest_version": 3,
  "name": "Meet mentoring groups",
  "version": "0.1.0",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "src/background.js" },
  "side_panel": { "default_path": "src/panel/panel.html" },
  "action": { "default_title": "Mentoring groups" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["src/meet/meet.js"] }
  ]
}
